    "lint": "eslint packages/ test/ scripts/"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "1.61.1",
    "@types/node": "20.19.43",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.64.0",
